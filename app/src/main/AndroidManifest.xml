<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pleos Playground SDK permissions (from the Pleos-Playground sample apps; all protectionLevel="normal").
         The SDK AARs themselves merge in their binding permissions and the <queries> for the fused-location service. -->
    <!-- FusedLocation (pleos-sample-fusedlocation-app) -->
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />
    <!-- Vehicle (pleos-sample-vehicle-app declares all CAR_* / CONTROL_* ones; only the read ones a drive log needs) -->
    <uses-permission android:name="pleos.car.permission.CAR_SPEED" />
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.CAR_INFO" />
    <uses-permission android:name="pleos.car.permission.CAR_MILEAGE" />
    <!-- NaviHelper (pleos-sample-navi-app) -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />

    <!-- AAOS car API: gear (CAR_POWERTRAIN, normal) and speed (CAR_SPEED, dangerous) -->
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
    <uses-permission android:name="android.car.permission.CAR_SPEED" />

    <!-- Android location fallback + the recording foreground service -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- only for the optional OpenFreeMap base-map overlay; the paper map works offline -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".OdomapApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Odomap">

        <uses-library android:name="android.car" android:required="false" />

        <activity
            android:name=".ui.MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:exported="true"
            android:resizeableActivity="true"
            android:screenOrientation="unspecified">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- AAOS: the app stays usable while driving — it shows its own glanceable screen (big numbers only) then -->
            <meta-data android:name="distractionOptimized" android:value="true" />
        </activity>

        <service
            android:name=".record.RecordingService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <receiver
            android:name=".record.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
